# name: test/sql/rs_zonal.test
# description: RS_ZonalStats(path, bbox, band, stat) — bbox 영역 집계 (RFC §6.8 Phase 2)
# group: [cog]

require cog

require-env COG_TEST_FIXTURES

# 영역: 좌상단 100x100 픽셀 (픽셀 중심 포함 규약) — rasterio+numpy 오라클 수치
query IIRII
SELECT RS_ZonalStats(f, [300000.0, 3999000.0, 301000.0, 4000000.0], 1, 'count')::BIGINT,
       RS_ZonalStats(f, [300000.0, 3999000.0, 301000.0, 4000000.0], 1, 'sum')::BIGINT,
       round(RS_ZonalStats(f, [300000.0, 3999000.0, 301000.0, 4000000.0], 1, 'mean'), 4),
       RS_ZonalStats(f, [300000.0, 3999000.0, 301000.0, 4000000.0], 1, 'min')::BIGINT,
       RS_ZonalStats(f, [300000.0, 3999000.0, 301000.0, 4000000.0], 1, 'max')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
10000	326869359	32686.9359	17	65532

# 타일 경계(256px)를 걸치는 영역 — 4개 타일에서 모아 집계
query II
SELECT RS_ZonalStats(f, [302000.0, 3997000.0, 303000.0, 3998000.0], 1, 'count')::BIGINT,
       RS_ZonalStats(f, [302000.0, 3997000.0, 303000.0, 3998000.0], 1, 'sum')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
10000	329035529

# nodata 픽셀은 집계에서 제외 (2x2 영역, 구멍 1개 → 유효 3)
query IIII
SELECT RS_ZonalStats(f, [900000.0, 3999980.0, 900020.0, 4000000.0], 1, 'count')::BIGINT,
       RS_ZonalStats(f, [900000.0, 3999980.0, 900020.0, 4000000.0], 1, 'sum')::BIGINT,
       RS_ZonalStats(f, [900000.0, 3999980.0, 900020.0, 4000000.0], 1, 'min')::BIGINT,
       RS_ZonalStats(f, [900000.0, 3999980.0, 900020.0, 4000000.0], 1, 'max')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/nodatahole_64x64_u16.tif' AS f);
----
3	26257	5849	14370

# 유효 픽셀 없는 영역: count → 0, 나머지 → NULL
query IR
SELECT RS_ZonalStats(f, [0.0, 0.0, 1.0, 1.0], 1, 'count')::BIGINT,
       RS_ZonalStats(f, [0.0, 0.0, 1.0, 1.0], 1, 'mean')
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
0	NULL

# 범위 밖 밴드 → NULL, stat 대소문자 무관
query RI
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', [300000.0, 3999000.0, 301000.0, 4000000.0], 9, 'mean'),
       RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', [300000.0, 3999000.0, 301000.0, 4000000.0], 1, 'MIN')::BIGINT;
----
NULL	17

# 모르는 stat → 에러
statement error
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', [300000.0, 3999000.0, 301000.0, 4000000.0], 1, 'median');
----
stat

# 역전 bbox → 에러
statement error
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', [301000.0, 3999000.0, 300000.0, 4000000.0], 1, 'mean');
----
bbox

# NULL 인자 → NULL
query R
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', NULL, 1, 'mean');
----
NULL

# 범위 밖 밴드에서 count/나머지 비대칭 계약: count → 0, sum → NULL
query IR
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', [300000.0, 3999000.0, 301000.0, 4000000.0], 9, 'count')::BIGINT,
       RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', [300000.0, 3999000.0, 301000.0, 4000000.0], 9, 'sum');
----
0	NULL

# ─── polygon zone (WKT VARCHAR 오버로드, #48) — rasterio geometry_mask 오라클 수치 ───

# P1: 4타일에 걸치는 오목(U-notch)+구멍 폴리곤 (픽셀 중심 포함, nodata 제외)
query IIRII
SELECT RS_ZonalStats(f, w, 1, 'count')::BIGINT,
       RS_ZonalStats(f, w, 1, 'sum')::BIGINT,
       round(RS_ZonalStats(f, w, 1, 'mean'), 4),
       RS_ZonalStats(f, w, 1, 'min')::BIGINT,
       RS_ZonalStats(f, w, 1, 'max')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f,
             'POLYGON ((301203.7 3995803.7, 304003.7 3995803.7, 304003.7 3998803.7, 303203.7 3998803.7, 303203.7 3996803.7, 302203.7 3996803.7, 302203.7 3998803.7, 301203.7 3998803.7, 301203.7 3995803.7), (303403.7 3996003.7, 303803.7 3996003.7, 303803.7 3996403.7, 303403.7 3996403.7, 303403.7 3996003.7))' AS w);
----
62400	2043359680	32746.1487	1	65535

# 폴리곤 vs 같은 extent 의 envelope bbox — notch+구멍 픽셀이 제외되어야 한다 (변별력)
query II
SELECT RS_ZonalStats(f, w, 1, 'count')::BIGINT,
       RS_ZonalStats(f, [301203.7, 3995803.7, 304003.7, 3998803.7], 1, 'count')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f,
             'POLYGON ((301203.7 3995803.7, 304003.7 3995803.7, 304003.7 3998803.7, 303203.7 3998803.7, 303203.7 3996803.7, 302203.7 3996803.7, 302203.7 3998803.7, 301203.7 3998803.7, 301203.7 3995803.7), (303403.7 3996003.7, 303803.7 3996003.7, 303803.7 3996403.7, 303403.7 3996403.7, 303403.7 3996003.7))' AS w);
----
62400	84000

# MULTIPOLYGON: 타일 경계(x=302560) 양쪽 정사각형 2개
query IIII
SELECT RS_ZonalStats(f, w, 1, 'count')::BIGINT,
       RS_ZonalStats(f, w, 1, 'sum')::BIGINT,
       RS_ZonalStats(f, w, 1, 'min')::BIGINT,
       RS_ZonalStats(f, w, 1, 'max')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f,
             'MULTIPOLYGON (((301003.7 3999003.7, 301503.7 3999003.7, 301503.7 3999503.7, 301003.7 3999503.7, 301003.7 3999003.7)), ((303003.7 3999003.7, 303503.7 3999003.7, 303503.7 3999503.7, 303003.7 3999503.7, 303003.7 3999003.7)))' AS w);
----
5000	165209622	29	65516

# 빗변 삼각형 — 비축정렬 PIP
query II
SELECT RS_ZonalStats(f, 'POLYGON ((300203.7 3999803.7, 301403.7 3999803.7, 300203.7 3998593.1, 300203.7 3999803.7))', 1, 'count')::BIGINT,
       RS_ZonalStats(f, 'POLYGON ((300203.7 3999803.7, 301403.7 3999803.7, 300203.7 3998593.1, 300203.7 3999803.7))', 1, 'sum')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
7267	239110784

# 폴리곤 zone 에서도 nodata 픽셀 제외 (2x2 덮개, 구멍 1개 → 유효 3)
query IIII
SELECT RS_ZonalStats(f, w, 1, 'count')::BIGINT,
       RS_ZonalStats(f, w, 1, 'sum')::BIGINT,
       RS_ZonalStats(f, w, 1, 'min')::BIGINT,
       RS_ZonalStats(f, w, 1, 'max')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/nodatahole_64x64_u16.tif' AS f,
             'POLYGON ((900001.3 3999981.3, 900018.7 3999981.3, 900018.7 3999998.7, 900001.3 3999998.7, 900001.3 3999981.3))' AS w);
----
3	26257	5849	14370

# POLYGON EMPTY / extent 밖 폴리곤 → count 0, mean NULL (bbox 역전과 달리 에러 아님)
query IRI
SELECT RS_ZonalStats(f, 'POLYGON EMPTY', 1, 'count')::BIGINT,
       RS_ZonalStats(f, 'POLYGON EMPTY', 1, 'mean'),
       RS_ZonalStats(f, 'POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))', 1, 'count')::BIGINT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
0	NULL	0

# 폴리곤 zone 에서 범위 밖 밴드: count → 0, sum → NULL (bbox 와 동일 비대칭)
query IR
SELECT RS_ZonalStats(f, 'POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))', 9, 'count')::BIGINT,
       RS_ZonalStats(f, 'POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))', 9, 'sum')
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
0	NULL

# NULL zone (VARCHAR 타입) → NULL
query R
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', CAST(NULL AS VARCHAR), 1, 'mean');
----
NULL

# POLYGON/MULTIPOLYGON 외 타입 → 에러
statement error
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', 'POINT (1 2)', 1, 'mean');
----
zone

# WKT 문법 오류 → 에러
statement error
SELECT RS_ZonalStats('${COG_TEST_FIXTURES}/basic_512x512_u16.tif', 'not wkt', 1, 'mean');
----
zone

# ─── 배치 zone (LIST(VARCHAR WKT) 오버로드, #60) ───
# 스칼라 경로와 동일 수치가 입력 순서대로 — 삼각형(7267) 뒤 MULTIPOLYGON(5000)
query T
SELECT RS_ZonalStats(f, [
         'POLYGON ((300203.7 3999803.7, 301403.7 3999803.7, 300203.7 3998593.1, 300203.7 3999803.7))',
         'MULTIPOLYGON (((301003.7 3999003.7, 301503.7 3999003.7, 301503.7 3999503.7, 301003.7 3999503.7, 301003.7 3999003.7)), ((303003.7 3999003.7, 303503.7 3999003.7, 303503.7 3999503.7, 303003.7 3999503.7, 303003.7 3999003.7)))'
       ], 1, 'count')::BIGINT[]::VARCHAR
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
[7267, 5000]

# sum 도 동일 정렬, extent 밖 zone 은 자리 보존 (count 0)
query T
SELECT RS_ZonalStats(f, [
         'POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))',
         'POLYGON ((300203.7 3999803.7, 301403.7 3999803.7, 300203.7 3998593.1, 300203.7 3999803.7))'
       ], 1, 'sum')::VARCHAR
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
[NULL, 239110784.0]

# NULL 원소는 NULL 자리로 (행 전체가 죽지 않는다)
query T
SELECT RS_ZonalStats(f, [
         NULL,
         'POLYGON ((300203.7 3999803.7, 301403.7 3999803.7, 300203.7 3998593.1, 300203.7 3999803.7))'
       ], 1, 'count')::VARCHAR
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
[NULL, 7267.0]

# 배치에서도 WKT 파싱 실패는 에러 (스칼라 규약 동일)
statement error
SELECT RS_ZonalStats(f, ['POLYGON ((broken'], 1, 'count')
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
RS_ZonalStats

# zone 리스트 인자 자체가 NULL 이면 행 NULL
query I
SELECT (RS_ZonalStats(f, NULL::VARCHAR[], 1, 'count') IS NULL)::INT
FROM (SELECT '${COG_TEST_FIXTURES}/basic_512x512_u16.tif' AS f);
----
1
